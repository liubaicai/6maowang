<!DOCTYPE html>
<html lang="zh-CN">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>
		<%= title || '遛猫网' %>
	</title>
	<link rel="stylesheet" href="/css/style.css" />
	<script src="//cdn.jsdelivr.net/npm/vue@3.5.21/dist/vue.global.min.js"></script>
	<script src="https://unpkg.com/masonry-layout@4/dist/masonry.pkgd.min.js"></script>
	<script src="https://unpkg.com/imagesloaded@5/imagesloaded.pkgd.min.js"></script>
	<style>
		#footer {
			height: 40px;
			line-height: 40px;
			position: fixed;
			bottom: 0;
			width: 100%;
			text-align: center;
			background: transparent;
			color: #666666;
			font-family: Arial;
			font-size: 12px;
			letter-spacing: 1px;
		}

		#footer a {
			color: #666666;
		}
	</style>
</head>

<body>
	<header class="topbar">
		<div class="topbar-inner">
			<a class="brand" href="/">
				<span>遛猫网</span>
			</a>
			<nav class="nav">
				<% if (isAuthenticated) { %>
					<a href="/albums/manage">管理</a>
					<a href="/account">账户</a>
					<form action="/logout" method="post" style="display:inline; margin: 0;">
						<input type="hidden" name="_csrf" value="<%= csrfToken %>" />
						<button class="link" type="submit">退出</button>
					</form>
				<% } else { %>
					<a href="/login">登录</a>
				<% } %>
			</nav>
		</div>
	</header>
	<main class="container">
		<%- body %>
	</main>
	<div id="globalLoading" class="loading-overlay">
		<div class="spinner"></div>
	</div>
	<script>
		// 全局 CSRF token 辅助函数
		window.getCsrfToken = function() {
			return '<%= csrfToken %>';
		};
		
		// 为 fetch 添加 CSRF token 的辅助函数
		window.fetchWithCsrf = function(url, options = {}) {
			options.headers = options.headers || {};
			if (options.method && options.method !== 'GET') {
				options.headers['X-CSRF-Token'] = window.getCsrfToken();
			}
			return fetch(url, options);
		};
	</script>
	<script src="/js/app.js"></script>
	<div id="footer">Copyright © <a href="https://github.com/liubaicai">菜园子</a> 2021, <a
			href="https://beian.miit.gov.cn/">京ICP备14022168号-2</a></div>
</body>

</html>