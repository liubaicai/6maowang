<!DOCTYPE html>
<html lang="zh-CN">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title><%= title || '遛猫网' %></title>
	<link rel="stylesheet" href="/css/style.css" />
	<script src="//cdn.jsdelivr.net/npm/vue@3.5.21/dist/vue.global.min.js"></script>
</head>
<body>
	<header class="topbar">
		<div class="container topbar-inner">
			<a class="brand" href="/">遛猫网</a>
			<nav class="nav" style="display: flex;align-items: center;">
				<% if (isAuthenticated) { %>
					<a href="/albums/manage">管理</a>
					<a href="/account">账户</a>
					<form action="/logout" method="post" style="display:inline">
						<button class="link">退出</button>
					</form>
				<% } else { %>
					<a href="/login">登录</a>
				<% } %>
			</nav>
		</div>
	</header>
	<main class="container">
		<%- body %>
	</main>
	<div id="globalLoading" class="loading-overlay"><div class="spinner"></div></div>
	<script src="/js/masonry.js"></script>
	<script src="/js/app.js"></script>
</body>
</html>


