<section>
  <h1>相册</h1>
  <% if (currentUser) { %>
    <a class="btn" href="/albums/new">创建相册</a>
  <% } %>
</section>

<% if (!albums || albums.length === 0) { %>
  <div style="text-align: center; padding: 60px 20px; color: var(--muted);">
    <div style="font-size: 18px; margin-bottom: 8px;">还没有相册</div>
    <div>登录后可以创建你的第一个相册</div>
  </div>
<% } else { %>
<div id="albumsApp" class="masonry">
  <% albums.forEach(a => { %>
    <a class="album-card masonry-item" href="/photos?album=<%= a.id %>" style="width: calc(25% - 12px);">
      <% if (a.cover_stored_filename) { %>
        <img src="/thumbs/<%= a.cover_stored_filename %>" alt="cover" />
      <% } else { %>
        <div class="placeholder">无封面</div>
      <% } %>
      <div class="meta">
        <div class="name"><%= a.name %></div>
        <div class="desc"><%= a.description || '' %></div>
      </div>
    </a>
  <% }) %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const container = document.getElementById('albumsApp');
  if (container && window.Masonry) {
    imagesLoaded(container, function() {
      new Masonry(container, {
        itemSelector: '.masonry-item',
        columnWidth: '.masonry-item',
        percentPosition: true,
        gutter: 16
      });
      container.classList.add('masonry-ready');
    });
  }
});
</script>
<% } %>


