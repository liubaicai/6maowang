# 环境配置示例
# 复制此文件为 .env 并修改相应的值

# 运行环境 (development | production)
NODE_ENV=production

# 服务端口
PORT=3000

# 会话密钥 (生产环境请使用强随机字符串)
SESSION_SECRET=change_this_to_a_random_secret_in_production

# 管理员初始密码 (首次启动时使用)
ADMIN_PASSWORD=admin

# 数据库路径
DB_PATH=./data/app.sqlite

# 日志级别 (error | warn | info | debug)
LOG_LEVEL=info

# 上传文件大小限制 (单位: MB)
MAX_FILE_SIZE=30
