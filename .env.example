# 环境变量配置示例
# 复制此文件为 .env 并修改配置

# Session 密钥（nuxt-auth-utils 使用，生产环境必须修改为至少 32 位随机字符串）
NUXT_SESSION_PASSWORD=your-super-secret-session-key-change-this-min-32-chars

# 管理员默认密码（首次启动时使用）
ADMIN_PASSWORD=admin

# 文件上传大小限制（MB）
MAX_FILE_SIZE=30

# 数据库路径（相对于项目根目录）
DATABASE_PATH=./data/app.sqlite

# 端口
PORT=3000
